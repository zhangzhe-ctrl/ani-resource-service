#!/usr/bin/env bash
set -Eeuo pipefail
cd "$(dirname "$0")/.."
BUF=${BUF:?set verified buf v1.60.0}
[[ $("$BUF" --version) == 1.60.0 ]]
export GOWORK=off
module=github.com/zhangzhe-ctrl/ani-accelerator-service
go mod download "$module"
upstream=$(go list -m -f '{{.Dir}}' "$module")
[[ -d $upstream/api/protos ]]
work=$(mktemp -d "${TMPDIR:?task-owned TMPDIR}/instance-api.XXXXXX")
trap 'rm -rf -- "$work"' EXIT
mkdir -p "$work/api/instance" "$work/api/compute" "$work/upstream"
cp -R api/compute/v1 "$work/api/compute/"
mkdir -p "$work/api/network"
cp -R api/network/v1 "$work/api/network/"
cp -R api/instance/v1 "$work/api/instance/"
mkdir -p "$work/api/instance/terminal"
cp -R api/instance/terminal/v1 "$work/api/instance/terminal/"
cp -R "$upstream/api/protos" "$work/upstream/accelerator"
chmod -R u+w "$work/upstream"
cp go.mod go.sum "$work/"
cat > "$work/buf.yaml" <<'EOF'
version: v2
modules:
  - path: api
  - path: upstream/accelerator
EOF
cat > "$work/buf.gen.yaml" <<'EOF'
version: v2
inputs:
  - directory: .
    paths: [api/compute/v1/compute.proto, api/instance/v1/instance.proto, api/instance/terminal/v1/terminal.proto]
plugins:
  - local: [go, run, google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.11]
    out: .
    opt: [paths=import, module=github.com/zhangzhe-ctrl/ani-resource-service]
  - local: [go, run, google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1]
    out: .
    opt: [paths=import, module=github.com/zhangzhe-ctrl/ani-resource-service]
EOF
(cd "$work" && "$BUF" build && "$BUF" generate)
cp "$work/api/instance/v1/instance.pb.go" "$work/api/instance/v1/instance_grpc.pb.go" api/instance/v1/
cp "$work/api/instance/terminal/v1/terminal.pb.go" "$work/api/instance/terminal/v1/terminal_grpc.pb.go" api/instance/terminal/v1/

cp "$work/api/compute/v1/compute.pb.go" "$work/api/compute/v1/compute_grpc.pb.go" api/compute/v1/
